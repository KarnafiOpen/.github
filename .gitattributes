# Handle line endings automatically for all text files
* text=auto eol=lf

# Force specific web, configuration, and code files to use LF
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.graphql text eol=lf

# Explicitly force Windows-specific scripts to use CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf


# Block Git from trying to generate text diffs for cryptographic keys/certs
*.key     binary
*.pem     binary
*.p12     binary
*.pfx     binary
*.crt     binary

# Treat local environmental or lockfiles as text but prevent accidental merging
.env*             text merge=binary
*.lock            text merge=binary
package-lock.json text merge=binary
yarn.lock         text merge=binary
pnpm-lock.yaml    text merge=binary


# Media and Video Assets
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.mov     filter=lfs diff=lfs merge=lfs -text
*.avi     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text

# Design and Archive Files
*.psd     filter=lfs diff=lfs merge=lfs -text
*.ai      filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
*.7z      filter=lfs diff=lfs merge=lfs -text

# 3D, Game Dev, and Database Files
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.obj     filter=lfs diff=lfs merge=lfs -text
*.sqlite  filter=lfs diff=lfs merge=lfs -text
*.db      filter=lfs diff=lfs merge=lfs -text


# Common Image formats
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary

# Compiled code and executables
*.exe     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.bin     binary
*.jar     binary

# Documents
*.pdf     binary


# Exclude local CI/CD configs and tools from production bundles
.github/           export-ignore
.husky/            export-ignore
.vscode/           export-ignore
.idea/             export-ignore

# Exclude testing suites and configuration baselines from releases
/tests/            export-ignore
.eslintrc*         export-ignore
.prettierrc*       export-ignore
.gitignore         export-ignore
.gitattributes     export-ignore